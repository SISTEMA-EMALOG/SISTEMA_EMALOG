# Modelo das variáveis de ambiente do Elastic Beanstalk.
#
# Copie para `session-secret.config` e preencha com os valores reais.
# O arquivo preenchido NÃO vai para o git (ver .gitignore) — ele entra
# apenas no zip de deploy.
#
# ATENÇÃO: os segredos abaixo já vazaram no histórico do git nos commits
# 22772a5 e 1646e5c. Rotacione SESSION_SECRET, INITIAL_ADMIN_PASSWORD e
# EVOLUTION_API_KEY antes de considerar este ambiente seguro.

option_settings:
  aws:elasticbeanstalk:application:environment:
    SESSION_SECRET: "PREENCHER-hex-aleatorio-64-chars"
    SESSION_COOKIE_SECURE: "false"
    INITIAL_ADMIN_EMAIL: "PREENCHER-email-do-admin"
    INITIAL_ADMIN_USERNAME: "admin"
    INITIAL_ADMIN_PASSWORD: "PREENCHER-senha-forte"
    EVOLUTION_API_URL: "PREENCHER-url-da-evolution"
    EVOLUTION_API_KEY: "PREENCHER-chave-da-evolution"
    EVOLUTION_INSTANCE: "PREENCHER-nome-da-instancia"
    CHATWOOT_URL: "PREENCHER-url-do-chatwoot"
    CHATWOOT_ACCOUNT_ID: "1"
    S3_BUCKET_NAME: "PREENCHER-nome-do-bucket"
    AWS_REGION: "us-east-1"
    AWS_ACCESS_KEY_ID: "PREENCHER-access-key-do-usuario-IAM"
    AWS_SECRET_ACCESS_KEY: "PREENCHER-secret-key-do-usuario-IAM"
    TWILIO_ACCOUNT_SID: "PREENCHER-account-sid-da-twilio"
    TWILIO_AUTH_TOKEN: "PREENCHER-auth-token-da-twilio"
    TWILIO_WHATSAPP_NUMBER: "whatsapp:+PREENCHER-numero"
    TWILIO_WEBHOOK_TOKEN: "PREENCHER-token-de-validacao-webhook"
